# Persistent Claude Remote Control supervisor for one repo.
#   Install:  ~/.config/systemd/user/claude-rc@.service
#   Enable:   systemctl --user enable --now claude-rc@<repo>
#             (%i is the directory name under ~/repos)
#   Once:     loginctl enable-linger "$USER"   # keep running after logout/reboot
#
# Requires workspace trust accepted once interactively in the repo
# (`cd ~/repos/<repo> && claude`), or this crashloops on every start.
#
# Deliberately NOT `--continue`: resuming forces spawnMode to
# single-session and skips pointer-based environment reuse. A plain start
# reads the bridge pointer, re-registers the same environment (so threads
# reconnect), and keeps worktree spawning. Restart is therefore idempotent
# and needs no wrapper logic.
#
# Stop only via `systemctl --user stop` (SIGTERM): clean shutdown
# preserves the server-side environment so the next start reconnects
# existing threads. SIGKILL forfeits that. Claude Code allows stuck
# sessions a 30s internal shutdown grace, so TimeoutStopSec stays above it.

[Unit]
Description=Claude Remote Control (%i)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
WorkingDirectory=%h/repos/%i
# bash -lc so the machine's own shell layer applies (~/.profile ->
# ~/.config/shell/profile.d/*: ~/.local/bin, rustup, Devbox Global) --
# systemd --user inherits none of it, and agents need those tools.
# repo-env exec then layers the project's direnv/devbox env on top; it
# passes straight through in repos with no managed env.
ExecStart=/bin/bash -lc 'exec repo-env exec claude remote-control --spawn=worktree'
# The status UI redraws ~1x/s on stdout (~430k journal lines/day per repo).
# Errors go to stderr, so nothing diagnostic is lost.
StandardOutput=null
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=60

[Install]
WantedBy=default.target
