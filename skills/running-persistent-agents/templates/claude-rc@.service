# Persistent Claude Remote Control supervisor for one repo.
#   Install:  ~/.config/systemd/user/claude-rc@.service
#   Enable:   systemctl --user enable --now claude-rc@<repo>
#             (%i is the directory name under ~/repos)
#   Once:     loginctl enable-linger "$USER"   # keep running after logout/reboot
#
# Requires workspace trust accepted once interactively in the repo
# (`cd ~/repos/<repo> && claude`), or this crashloops on every start.
#
# Stop only via `systemctl --user stop` (SIGTERM): clean shutdown
# preserves the server-side environment so the next start reconnects
# existing claude.ai threads. SIGKILL forfeits that. Claude Code allows
# stuck sessions a 30s internal shutdown grace, so TimeoutStopSec stays
# above it.

[Unit]
Description=Claude Remote Control (%i)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
WorkingDirectory=%h/repos/%i
# systemd --user does not inherit the login PATH, and claude lives in
# ~/.local/bin; repo-env/direnv only prepend to whatever PATH they inherit.
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin:/usr/local/sbin:/usr/sbin:/sbin
# The status UI redraws ~1x/s on stdout (~430k journal lines/day per repo).
# Errors and the wrapper's own messages go to stderr, so nothing useful is lost.
StandardOutput=null
# repo-env exec: project toolchain without an interactive direnv shell
# (see using-project-envs). Harmless in repos with no managed env --
# it passes the command straight through.
ExecStart=%h/.local/bin/repo-env exec %h/.local/bin/claude-rc-supervise %h/repos/%i --spawn=worktree
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=60

[Install]
WantedBy=default.target
